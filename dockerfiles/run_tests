FROM alpine:3.23.4 AS build
RUN apk add meson libgcc musl-dev gcc g++ upx
COPY . /code
RUN mkdir /build
WORKDIR /code
# The commit the build was made from. The host computes it and passes
# it in, because this image has no git to ask.
ARG WARTHOG_COMMIT=unknown
ENV WARTHOG_COMMIT=${WARTHOG_COMMIT}
RUN --mount=type=cache,target=/build LDFLAGS='-static' meson /build/code --default-library static --buildtype=release
WORKDIR /build/code
RUN  --mount=type=cache,target=/build meson test -v
